# Copy to .env and adjust if your Postgres port/credentials differ.
DATABASE_URL=postgresql+psycopg://ember:ember@localhost:5433/ember
ENVIRONMENT=development

# Comma-separated. Never use * in production (credentials would be rejected anyway).
CORS_ORIGINS=http://localhost:5173

COOKIE_NAME=ember_session
COOKIE_SECURE=false
# lax for local/same-site; none (with COOKIE_SECURE=true) for split frontend/backend hosts.
COOKIE_SAMESITE=lax
SESSION_TTL_SECONDS=1209600

# Per IP, in this process only.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900
