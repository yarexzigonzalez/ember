# copy to .env for local dev. prod values live in Render, not here.
DATABASE_URL=postgresql+psycopg://ember:ember@localhost:5433/ember
ENVIRONMENT=development

# leave empty: vite proxies /api locally and vercel proxies it in prod,
# so the browser never makes a cross-origin call.
CORS_ORIGINS=

COOKIE_NAME=ember_session
# true in prod (https). false locally since localhost is plain http.
COOKIE_SECURE=false
SESSION_TTL_SECONDS=1209600

# login/register/demo: 10 tries per 15 min per IP, counted in this process.
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=900

# proxies in front of the API. 0 locally, 2 on render behind vercel.
TRUSTED_PROXY_HOPS=0
LOG_CLIENT_IP=false

# quick add. leave the key empty and it just uses the regex extractor.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
